generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tasks     Task[]
}

model Task {
  id           Int      @id @default(autoincrement())
  title        String
  description  String
  status       Status   @default(TODO)
  priority     Priority
  dueDate      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  assignedToId Int
  assignedTo   User     @relation(fields: [assignedToId], references: [id], onDelete: Cascade)
}

enum Priority {
  HIGH
  LOW
  MEDIUM
}

enum Status {
  TODO
  IN_PROGRESS
  COMPLETED
}

